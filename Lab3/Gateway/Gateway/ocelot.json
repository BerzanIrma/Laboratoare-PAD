{
  "Routes": [
    {
      "UpstreamPathTemplate": "/hotels",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/hotels",
      "DownstreamScheme": "http",
      "ServiceName": "hotel-api",
      "LoadBalancerOptions": { "Type": "RoundRobin" },
      "DownstreamHeaderTransform": { "Location": "{DownstreamBaseUrl}, {BaseUrl}" },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 10000,
        "TimeoutValue": 3000
      },
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "ClientWhitelist": [ "premium" ],
        "Period": "10s",
        "PeriodTimespan": 10,
        "Limit": 20
      }
    },
    {
      "UpstreamPathTemplate": "/hotels/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/hotels/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "hotel-api",
      "LoadBalancerOptions": { "Type": "RoundRobin" },
      "DownstreamHeaderTransform": { "Location": "{DownstreamBaseUrl}, {BaseUrl}" },
      "QoSOptions": {
        "ExceptionsAllowedBeforeBreaking": 3,
        "DurationOfBreak": 10000,
        "TimeoutValue": 3000
      },
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "ClientWhitelist": [ "premium" ],
        "Period": "10s",
        "PeriodTimespan": 10,
        "Limit": 20
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5001",
    "ServiceDiscoveryProvider": {
      "Scheme": "http",
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    },
    "RateLimitOptions": {
      "ClientIdHeader": "ClientId",
      "QuotaExceededMessage": "Prea multe cereri. Incearca din nou peste cateva secunde.",
      "HttpStatusCode": 429
    }
  }
}