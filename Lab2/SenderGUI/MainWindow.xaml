<Window x:Class="SenderGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sender (gRPC)" Height="520" Width="620"
        Background="#F5F5F7"
        FontFamily="Segoe UI">
    <!--
        Fereastra SenderGUI: doar aspectul, fara logica.
        Fiecare {Binding X} este legat de proprietatea X din MainViewModel.cs
        (legatura se face in MainWindow.xaml.cs: DataContext = new MainViewModel()).
    -->

    <!-- Stiluri comune: cum arata toate butoanele si campurile de text din fereastra -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SUS: formularul de trimitere (PASUL 4) -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <!-- Publisher ID: generat aleator in MainViewModel, doar se afiseaza -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Publisher ID" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PublisherId}" FontFamily="Consolas"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <!-- Topic: ce scrii aici ajunge imediat in MainViewModel.Topic
                     (UpdateSourceTrigger=PropertyChanged = la fiecare tasta, nu doar la iesirea din camp) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Topic" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- Message: legat de MainViewModel.Content; Enter = acelasi lucru ca butonul Send -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Message" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>

                <!-- Butonul Send -> MainViewModel.SendCommand -> SendMessageAsync();
                     langa el, Status = raspunsul Broker-ului sau eroarea -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Send" Command="{Binding SendCommand}" Width="110"/>
                    <TextBlock Text="{Binding Status}" Foreground="#0078D4" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- JOS: istoricul mesajelor trimise din aceasta fereastra (MainViewModel.SentMessages) -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Istoric trimise" FontWeight="SemiBold" Margin="4,4,0,8"/>
                <ListView ItemsSource="{Binding SentMessages}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <!-- fiecare coloana afiseaza o proprietate din clasa SentMessage -->
                            <GridViewColumn Header="Ora" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss}" Width="80"/>
                            <GridViewColumn Header="Topic" DisplayMemberBinding="{Binding Topic}" Width="110"/>
                            <GridViewColumn Header="Mesaj" DisplayMemberBinding="{Binding Content}" Width="260"/>
                            <GridViewColumn Header="Rezultat" DisplayMemberBinding="{Binding Result}" Width="90"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
